# Non-secret configuration only: files in assets/ are bundled into the app.
# Server-side keys belong in Cloud Functions, never here.
# Copy to .env.prod with: bash scripts/setup_env.sh
API_BASE_URL=https://api.example.com
API_KEY=
ENABLE_LOGGING=false
ENABLE_CURL_LOGGING=false
SHOW_DEBUG_BANNER=false
TIMEOUT_MS=30000
